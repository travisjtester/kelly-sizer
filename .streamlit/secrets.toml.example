# Settings -> Secrets on Streamlit Cloud. Never commit the real file.
[storage]
repo = "travisjtester/kelly-sizer-data"   # a PRIVATE repo for your journal and views
token = "github_pat_..."                  # fine-grained token: that repo only, Contents read/write
passphrase = "a long phrase only you know" # unlocks loading and saving in the app
